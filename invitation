  <script>
    /**
     * 1. TWINKLING TWILIGHT STARFIELD CANVAS
     * Responsive full-viewport canvas creating a warm starry twilight atmosphere.
     */
    (function initStarfield() {
      const canvas = document.getElementById('starfield');
      const ctx = canvas.getContext('2d');
      let stars = [];
      let width = 0;
      let height = 0;

      function resizeCanvas() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        createStars();
      }

      function createStars() {
        const count = Math.min(95, Math.floor((width * height) / 9000));
        stars = [];
        for (let i = 0; i < count; i++) {
          stars.push({
            x: Math.random() * width,
            y: Math.random() * height * 0.85,
            radius: Math.random() * 1.5 + 0.4,
            alpha: Math.random(),
            speed: Math.random() * 0.015 + 0.005,
            hue: Math.random() > 0.35 ? '254, 243, 199' : '253, 186, 116'
          });
        }
      }

      function animateStars() {
        ctx.clearRect(0, 0, width, height);
        for (const star of stars) {
          star.alpha += star.speed;
          if (star.alpha > 1 || star.alpha < 0.15) {
            star.speed = -star.speed;
          }
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${star.hue}, ${Math.max(0.15, Math.min(1, star.alpha))})`;
          ctx.fill();
        }
        requestAnimationFrame(animateStars);
      }

      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();
      animateStars();
    })();

    /**
     * 2. ROMANTIC WEB AUDIO API SYNTHESIZER (iOS/iPadOS Safari Friendly)
     * Plays a lush, warm electric-piano & ambient-pad progression (Fmaj7 -> Em7 -> Dm7 -> Cmaj7)
     * with delicate music-box melody notes. Unlocked cleanly on user gesture.
     */
    const RomanticMusicPlayer = (function () {
      let audioCtx = null;
      let masterGain = null;
      let isPlaying = false;
      let stepTimer = null;
      let stepIndex = 0;

      // Chord progression: Fmaj7 -> Em7 -> Dm7 -> Cmaj7 (frequencies in Hz)
      const progression = [
        {
          chords: [174.61, 220.00, 261.63, 329.63], // F3, A3, C4, E4 (Fmaj7)
          melody: [659.25, 587.33, 523.25, 659.25]  // E5, D5, C5, E5
        },
        {
          chords: [164.81, 196.00, 246.94, 293.66], // E3, G3, B3, D4 (Em7)
          melody: [587.33, 493.88, 392.00, 493.88]  // D5, B4, G4, B4
        },
        {
          chords: [146.83, 174.61, 220.00, 261.63], // D3, F3, A3, C4 (Dm7)
          melody: [523.25, 440.00, 349.23, 440.00]  // C5, A4, F4, A4
        },
        {
          chords: [130.81, 196.00, 246.94, 329.63], // C3, G3, B3, E4 (Cmaj7)
          melody: [493.88, 523.25, 659.25, 783.99]  // B4, C5, E5, G5
        }
      ];

      function initContext() {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioContextClass();

          masterGain = audioCtx.createGain();
          masterGain.gain.setValueAtTime(0.0001, audioCtx.currentTime);
          masterGain.connect(audioCtx.destination);
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
      }

      // Warm Rhodes-style electric piano chord voice
      function playPadChord(freqs, duration) {
        if (!audioCtx || !isPlaying) return;
        const now = audioCtx.currentTime;

        freqs.forEach((freq, idx) => {
          const osc = audioCtx.createOscillator();
          const subOsc = audioCtx.createOscillator();
          const filter = audioCtx.createBiquadFilter();
          const voiceGain = audioCtx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now);

          // Subtle warm harmonic overtone
          subOsc.type = 'triangle';
          subOsc.frequency.setValueAtTime(freq * 2, now);

          const subGain = audioCtx.createGain();
          subGain.gain.setValueAtTime(0.08, now);

          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(920, now);
          filter.frequency.exponentialRampToValueAtTime(420, now + duration);

          // Gentle swell and release envelope
          const peakGain = 0.045 / (1 + idx * 0.12);
          voiceGain.gain.setValueAtTime(0.0001, now);
          voiceGain.gain.linearRampToValueAtTime(peakGain, now + 0.45);
          voiceGain.gain.exponentialRampToValueAtTime(0.0001, now + duration + 0.4);

          osc.connect(filter);
          subOsc.connect(subGain);
          subGain.connect(filter);
          filter.connect(voiceGain);
          voiceGain.connect(masterGain);

          osc.start(now);
          subOsc.start(now);
          osc.stop(now + duration + 0.5);
          subOsc.stop(now + duration + 0.5);
        });
      }

      // Delicate music-box bell melody note
      function playMusicBoxNote(freq) {
        if (!audioCtx || !isPlaying) return;
        const now = audioCtx.currentTime;

        const osc = audioCtx.createOscillator();
        const overtone = audioCtx.createOscillator();
        const noteGain = audioCtx.createGain();
        const overtoneGain = audioCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now);

        overtone.type = 'sine';
        overtone.frequency.setValueAtTime(freq * 3, now);
        overtoneGain.gain.setValueAtTime(0.04, now);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.35);

        noteGain.gain.setValueAtTime(0.0001, now);
        noteGain.gain.linearRampToValueAtTime(0.038, now + 0.03);
        noteGain.gain.exponentialRampToValueAtTime(0.0001, now + 1.45);

        osc.connect(noteGain);
        overtone.connect(overtoneGain);
        overtoneGain.connect(noteGain);
        noteGain.connect(masterGain);

        osc.start(now);
        overtone.start(now);
        osc.stop(now + 1.55);
        overtone.stop(now + 1.55);
      }

      function scheduleStep() {
        if (!isPlaying) return;
        const barIndex = Math.floor(stepIndex / 4) % progression.length;
        const beatInBar = stepIndex % 4;
        const currentBar = progression[barIndex];

        // Trigger warm chord on beat 0 of every 4-beat bar
        if (beatInBar === 0) {
          playPadChord(currentBar.chords, 3.3);
        }

        // Trigger delicate music-box melody note on each beat
        const melodyFreq = currentBar.melody[beatInBar];
        if (melodyFreq) {
          playMusicBoxNote(melodyFreq);
        }

        stepIndex++;
      }

      function start() {
        initContext();
        if (isPlaying) return;
        isPlaying = true;

        const now = audioCtx.currentTime;
        masterGain.gain.cancelScheduledValues(now);
        masterGain.gain.setValueAtTime(Math.max(0.0001, masterGain.gain.value), now);
        masterGain.gain.linearRampToValueAtTime(0.85, now + 0.8);

        scheduleStep();
        stepTimer = setInterval(scheduleStep, 850);
        updateToggleUI(true);
      }

      function stop() {
        if (!isPlaying) return;
        isPlaying = false;
        if (stepTimer) {
          clearInterval(stepTimer);
          stepTimer = null;
        }
        if (audioCtx && masterGain) {
          const now = audioCtx.currentTime;
          masterGain.gain.cancelScheduledValues(now);
          masterGain.gain.setValueAtTime(Math.max(0.0001, masterGain.gain.value), now);
          masterGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.45);
        }
        updateToggleUI(false);
      }

      function toggle() {
        if (isPlaying) {
          stop();
        } else {
          start();
        }
      }

      function updateToggleUI(playing) {
        const btn = document.getElementById('musicToggleBtn');
        const icon = document.getElementById('musicIcon');
        const label = document.getElementById('musicLabel');
        if (!btn) return;

        if (playing) {
          btn.classList.remove('music-muted');
          btn.classList.add('music-playing');
          icon.textContent = '🎵';
          label.textContent = 'Playing';
        } else {
          btn.classList.remove('music-playing');
          btn.classList.add('music-muted');
          icon.textContent = '🔇';
          label.textContent = 'Muted';
        }
      }

      return { start, stop, toggle, isPlaying: () => isPlaying };
    })();

    /**
     * 3. SCREEN NAVIGATION & INTERACTIVE LOGIC
     */
    document.addEventListener('DOMContentLoaded', () => {
      const introScreen = document.getElementById('introScreen');
      const inviteScreen = document.getElementById('inviteScreen');
      const passScreen = document.getElementById('passScreen');

      const openInviteBtn = document.getElementById('openInviteBtn');
      const musicToggleBtn = document.getElementById('musicToggleBtn');
      const yesBtn = document.getElementById('yesBtn');
      const noBtn = document.getElementById('noBtn');
      const replayBtn = document.getElementById('replayBtn');
      const promptArena = document.getElementById('promptArena');
      const teaseMessage = document.getElementById('teaseMessage');

      // Cute playful messages when she tries to tap "No"
      const dodgePhrases = [
        "Are you sure? 🥺",
        "Try again, Baby! 😉",
        "Wrong button 😜",
        "You know you want to! 💕",
        "Marugame Udon is waiting for us! 🍜",
        "MOA Sky won’t be the same without you! 🌃",
        "Okay fine, just tap Yes! ❤️"
      ];

      let dodgeCount = 0;

      // Floating Music Pill Toggle
      musicToggleBtn.addEventListener('click', () => {
        RomanticMusicPlayer.toggle();
      });

      function switchScreen(fromEl, toEl) {
        fromEl.classList.remove('screen-visible');
        fromEl.classList.add('screen-hidden');

        setTimeout(() => {
          toEl.classList.remove('screen-hidden');
          toEl.classList.add('screen-visible');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, 280);
      }

      // Open Envelope -> Unlock & Auto-Start Romantic Music + Show Date Itinerary
      openInviteBtn.addEventListener('click', () => {
        RomanticMusicPlayer.start();
        spawnHeartBurst(10);
        switchScreen(introScreen, inviteScreen);
      });

      // Playful Dodging "No" Button (Supports iPhone/iPad Touch + Desktop Hover/Click)
      function dodgeNoButton(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }

        // Update tease text
        teaseMessage.textContent = dodgePhrases[dodgeCount % dodgePhrases.length];
        dodgeCount++;

        // Calculate safe bounds inside promptArena so the button stays visible & tappable
        const arenaRect = promptArena.getBoundingClientRect();
        const btnRect = noBtn.getBoundingClientRect();

        const maxOffsetX = Math.max(40, (arenaRect.width - btnRect.width) * 0.42);
        const maxOffsetY = Math.max(24, (arenaRect.height - btnRect.height) * 0.36);

        // Generate a noticeable jump away from current position
        const randomX = (Math.random() * 2 - 1) * maxOffsetX;
        const randomY = (Math.random() * 2 - 1) * maxOffsetY;

        noBtn.style.transform = `translate(${randomX.toFixed(0)}px, ${randomY.toFixed(0)}px)`;
      }

      // Bind touchstart, pointerdown, mouseover, and click for reliable iOS Safari & desktop responsiveness
      noBtn.addEventListener('touchstart', dodgeNoButton, { passive: false });
      noBtn.addEventListener('pointerdown', dodgeNoButton);
      noBtn.addEventListener('mouseover', dodgeNoButton);
      noBtn.addEventListener('click', dodgeNoButton);

      // Tap "Yes" -> Celebrate & Reveal Official Date Pass
      yesBtn.addEventListener('click', () => {
        spawnHeartBurst(28);
        switchScreen(inviteScreen, passScreen);
      });

      // Replay Invite
      replayBtn.addEventListener('click', () => {
        dodgeCount = 0;
        noBtn.style.transform = 'translate(0px, 0px)';
        teaseMessage.textContent = 'Choose wisely 💕';
        switchScreen(passScreen, introScreen);
      });

      /**
       * 3. CELEBRATORY FLOATING HEARTS & SPARKLES BURST
       */
      function spawnHeartBurst(count) {
        const emojis = ['❤️', '💕', '✨', '💖', '🌅', '🍜'];
        for (let i = 0; i < count; i++) {
          setTimeout(() => {
            const heart = document.createElement('span');
            heart.className = 'floating-heart';
            heart.textContent = emojis[Math.floor(Math.random() * emojis.length)];
            heart.style.left = `${Math.random() * 92 + 4}vw`;
            heart.style.fontSize = `${Math.random() * 16 + 16}px`;
            heart.style.animationDuration = `${Math.random() * 1.8 + 2.2}s`;
            document.body.appendChild(heart);

            heart.addEventListener('animationend', () => {
              heart.remove();
            });
          }, i * 65);
        }
      }
    });
  </script>
</body>
