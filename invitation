<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>A Sunset Date for You, Baby ✨</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Cormorant Garamond (Romantic Display Serif) & Plus Jakarta Sans (Clean Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* Custom Typography & Base Settings */
    :root {
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100dvh;
      overflow-x: hidden;
      font-family: var(--font-sans);
      color: #fdf6f0;
      /* Deep twilight sunset gradient: Midnight Indigo -> Dusk Plum -> Warm Amber Rose */
      background: linear-gradient(160deg, #0b1026 0%, #1b1738 42%, #3d2247 74%, #6b354b 100%);
      background-attachment: fixed;
    }

    .font-serif-display {
      font-family: var(--font-serif);
    }

    /* Warm Sunset Horizon Glow */
    .twilight-glow {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(circle at 50% 95%, rgba(251, 146, 60, 0.28) 0%, rgba(244, 114, 182, 0.12) 38%, transparent 70%),
        radial-gradient(circle at 18% 18%, rgba(129, 140, 248, 0.14) 0%, transparent 45%);
    }

    /* Twinkling Stars Canvas */
    #starfield {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    /* Glassmorphism Card Styling */
    .glass-card {
      background: rgba(24, 19, 44, 0.62);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(253, 212, 182, 0.22);
      box-shadow:
        0 20px 50px rgba(6, 8, 22, 0.55),
        inset 0 1px 0 rgba(255, 237, 213, 0.16);
    }

    .glass-subcard {
      background: rgba(255, 245, 238, 0.06);
      border: 1px solid rgba(253, 186, 116, 0.2);
    }

    /* Envelope Seal Pulse Animation */
    @keyframes pulseGlow {
      0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(251, 146, 60, 0.55), 0 10px 25px rgba(225, 29, 72, 0.45);
      }
      50% {
        transform: scale(1.06);
        box-shadow: 0 0 0 14px rgba(251, 146, 60, 0), 0 14px 32px rgba(225, 29, 72, 0.65);
      }
    }

    .wax-seal-btn {
      animation: pulseGlow 2.6s infinite ease-in-out;
      background: radial-gradient(circle at 30% 30%, #fb7185, #be123c 75%, #881337 100%);
      border: 2px solid rgba(254, 215, 170, 0.55);
    }

    /* Gentle Floating Animation */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }

    .animate-float {
      animation: floatSlow 4s ease-in-out infinite;
    }

    /* Screen Transitions */
    .screen-section {
      transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .screen-hidden {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
      pointer-events: none;
      position: absolute;
      visibility: hidden;
    }

    .screen-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
      position: relative;
      visibility: visible;
    }

    /* Dodging No Button Smooth Transition */
    #noBtn {
      transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease;
      touch-action: manipulation;
      user-select: none;
    }

    /* Primary Yes Button Shimmer */
    .btn-yes {
      background: linear-gradient(135deg, #f59e0b 0%, #f43f5e 55%, #db2777 100%);
      box-shadow: 0 10px 26px rgba(244, 63, 94, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.35);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-yes:active {
      transform: scale(0.96);
    }

    /* Ticket Perforation Divider */
    .ticket-divider {
      position: relative;
      border-top: 1.5px dashed rgba(253, 186, 116, 0.35);
    }

    .ticket-divider::before,
    .ticket-divider::after {
      content: '';
      position: absolute;
      top: -11px;
      width: 20px;
      height: 20px;
      border-radius: 9999px;
      background: #23193b;
      border: 1px solid rgba(253, 212, 182, 0.22);
    }

    .ticket-divider::before {
      left: -31px;
    }

    .ticket-divider::after {
      right: -31px;
    }

    /* Floating Celebration Hearts */
    @keyframes riseHeart {
      0% {
        transform: translateY(0) scale(0.6) rotate(0deg);
        opacity: 0;
      }
      15% {
        opacity: 1;
      }
      100% {
        transform: translateY(-85vh) scale(1.25) rotate(24deg);
        opacity: 0;
      }
    }

    .floating-heart {
      position: fixed;
      bottom: -30px;
      pointer-events: none;
      z-index: 50;
      animation: riseHeart linear forwards;
    }

    /* Animated Equalizer Bars for Floating Music Pill */
    @keyframes eqBounce {
      0%, 100% { transform: scaleY(0.35); }
      50% { transform: scaleY(1); }
    }

    .eq-bar {
      width: 2.5px;
      height: 12px;
      border-radius: 9999px;
      background-color: #fcd34d;
      transform-origin: bottom;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .music-playing .eq-bar:nth-child(1) { animation: eqBounce 0.85s infinite ease-in-out; }
    .music-playing .eq-bar:nth-child(2) { animation: eqBounce 0.65s infinite ease-in-out 0.2s; }
    .music-playing .eq-bar:nth-child(3) { animation: eqBounce 0.95s infinite ease-in-out 0.35s; }

    .music-muted .eq-bar {
      transform: scaleY(0.3);
      opacity: 0.45;
      animation: none;
    }
  </style>
</head>
